<div class="max-w-5xl mx-auto">

  <div class="mb-10">
    <h1 class="text-4xl font-bold text-white">
      🐛 Error Debugger
    </h1>

    <p class="mt-3 text-slate-400">
      Pega un error de Ruby o Rails y la IA te explicará qué significa,
      las posibles causas y cómo solucionarlo.
    </p>
  </div>

  <%= form_with url: error_debugger_index_path,
                method: :post,
                data: { turbo: false } do |f| %>

    <div class="space-y-4">

      <%= f.text_area :error,
                      rows: 14,
                      placeholder: <<~TEXT,
NoMethodError:
undefined method `name' for nil:NilClass
          TEXT
                      class: "w-full rounded-xl bg-slate-900 border border-slate-700 p-4 text-white font-mono focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" %>

      <%= f.submit "Analizar error",
                   class: "rounded-lg bg-cyan-600 px-6 py-3 font-semibold text-white hover:bg-cyan-700 transition" %>

    </div>

  <% end %>

  <% if @response.present? %>

    <div class="mt-8 p-6 bg-slate-800 rounded-lg text-white">
      <h2 class="text-xl font-bold mb-4">
        Análisis del error
      </h2>

      <pre class="whitespace-pre-wrap">
        <%= @response %>
      </pre>
    </div>

  <% end %>

</div>