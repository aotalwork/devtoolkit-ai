<div class="max-w-6xl mx-auto py-14">

  <!-- Hero -->
  <div class="mb-20 text-center">


    <h1 class="text-6xl md:text-7xl font-extrabold mb-8 text-white tracking-tight">
      🚀 AI Dev Toolkit
    </h1>


    <p class="text-xl md:text-2xl text-slate-300 max-w-4xl mx-auto leading-relaxed mb-4">
      Una suite inteligente de herramientas impulsadas por IA para ayudarte a
      desarrollar mejor software, encontrar errores más rápido y automatizar
      tareas repetitivas del día a día.
    </p>



    <!-- Stats -->
    <div class="flex justify-center gap-20 mt-16 mb-10 flex-wrap">


      <div class="text-center w-44">
        <div class="text-4xl font-bold text-cyan-400 mb-3">
          7
        </div>
        <div class="text-slate-400 whitespace-nowrap">
          Herramientas AI
        </div>
      </div>


      <div class="text-center w-44">
        <div class="text-4xl font-bold text-purple-400 mb-3">
          ∞
        </div>
        <div class="text-slate-400 whitespace-nowrap">
          Posibilidades
        </div>
      </div>


      <div class="text-center w-44">
        <div class="text-4xl font-bold text-yellow-400 mb-3">
          ⚡
        </div>
        <div class="text-slate-400 whitespace-nowrap">
          Más productividad
        </div>
      </div>


    </div>

  </div>



  <!-- Tools -->
  <div>


    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">


      <%= link_to error_debugger_index_path,
                  class: "group block p-6 bg-slate-800 text-white rounded-xl shadow-lg hover:bg-slate-700 transition duration-200 border border-slate-700 hover:border-cyan-500/50" do %>

        <div class="text-4xl mb-4 group-hover:scale-110 transition">
          🐛
        </div>

        <h2 class="text-xl font-bold mb-2">
          Error Debugger
        </h2>

        <p class="text-slate-300 leading-relaxed">
          Analiza errores, excepciones y trazas de código para encontrar
          rápidamente la causa del problema y posibles soluciones.
        </p>

      <% end %>



      <%= link_to test_generator_index_path,
                  class: "group block p-6 bg-slate-800 text-white rounded-xl shadow-lg hover:bg-slate-700 transition duration-200 border border-slate-700 hover:border-green-500/50" do %>

        <div class="text-4xl mb-4 group-hover:scale-110 transition">
          🧪
        </div>

        <h2 class="text-xl font-bold mb-2">
          Test Generator
        </h2>

        <p class="text-slate-300 leading-relaxed">
          Genera tests automáticamente a partir de tu código para mejorar
          calidad, estabilidad y cobertura.
        </p>

      <% end %>



      <%= link_to commit_coach_index_path,
                  class: "group block p-6 bg-slate-800 text-white rounded-xl shadow-lg hover:bg-slate-700 transition duration-200 border border-slate-700 hover:border-yellow-500/50" do %>

        <div class="text-4xl mb-4 group-hover:scale-110 transition">
          📝
        </div>

        <h2 class="text-xl font-bold mb-2">
          Commit Coach
        </h2>

        <p class="text-slate-300 leading-relaxed">
          Mejora tus mensajes de commit siguiendo buenas prácticas
          profesionales de Git.
        </p>

      <% end %>



      <%= link_to readme_generator_index_path,
                  class: "group block p-6 bg-slate-800 text-white rounded-xl shadow-lg hover:bg-slate-700 transition duration-200 border border-slate-700 hover:border-blue-500/50" do %>

        <div class="text-4xl mb-4 group-hover:scale-110 transition">
          📖
        </div>

        <h2 class="text-xl font-bold mb-2">
          README Generator
        </h2>

        <p class="text-slate-300 leading-relaxed">
          Crea documentación profesional automáticamente para tus proyectos.
        </p>

      <% end %>



      <%= link_to pr_reviewer_index_path,
                  class: "group block p-6 bg-slate-800 text-white rounded-xl shadow-lg hover:bg-slate-700 transition duration-200 border border-slate-700 hover:border-purple-500/50" do %>

        <div class="text-4xl mb-4 group-hover:scale-110 transition">
          👀
        </div>

        <h2 class="text-xl font-bold mb-2">
          PR Reviewer
        </h2>

        <p class="text-slate-300 leading-relaxed">
          Revisa Pull Requests, detecta problemas y propone mejoras.
        </p>

      <% end %>



      <%= link_to sql_optimizer_index_path,
                  class: "group block p-6 bg-slate-800 text-white rounded-xl shadow-lg hover:bg-slate-700 transition duration-200 border border-slate-700 hover:border-orange-500/50" do %>

        <div class="text-4xl mb-4 group-hover:scale-110 transition">
          🔍
        </div>

        <h2 class="text-xl font-bold mb-2">
          SQL Optimizer
        </h2>

        <p class="text-slate-300 leading-relaxed">
          Optimiza consultas SQL y mejora el rendimiento de tus aplicaciones.
        </p>

      <% end %>



      <%= link_to code_explainer_index_path,
                  class: "group block p-6 bg-slate-800 text-white rounded-xl shadow-lg hover:bg-slate-700 transition duration-200 border border-slate-700 hover:border-cyan-500/50" do %>

        <div class="text-4xl mb-4 group-hover:scale-110 transition">
          📚
        </div>

        <h2 class="text-xl font-bold mb-2">
          Code Explainer
        </h2>

        <p class="text-slate-300 leading-relaxed">
          Explica código complejo usando lenguaje natural para facilitar
          comprensión y aprendizaje.
        </p>

      <% end %>


    </div>

  </div>

</div>